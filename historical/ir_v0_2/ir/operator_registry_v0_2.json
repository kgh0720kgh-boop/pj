        {"code": "JOIN_NO_MATCH", "when": "No row key matches."},
        {"code": "JOIN_AMBIGUOUS_MATCH", "when": "A downstream singleton is required but multiple rows match."}
      ],
      "generation": {
        "enabled": true,
        "argument_candidate_sources": {
          "right_column": "table_schema_column",
          "match": "registry_enum"
