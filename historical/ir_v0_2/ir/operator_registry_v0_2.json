{
  "registry_version": "0.2",
  "ir_version": "0.2",
  "description": "Machine-readable operator registry frozen for the first Week 2 HybridQA planner experiment. It contains exactly the eleven operators observed in the Week 1 sample taxonomy.",
  "generation_contract": {
    "profile": "model_generated_plan",
    "operator_enumeration": "Use the keys of operators whose generation.enabled is true.",
    "allowed_source_types": ["Table"],
    "allowed_source_locator_kinds": ["hybridqa_table"],
    "fixed_output_port": "result",
    "forbidden_gold_or_runtime_fields": [
      "question_ref.answer",
      "nodes[*].provenance",
      "nodes[*].status",
      "nodes[*].execution",
      "nodes[*].arguments.span",
      "nodes[*].arguments.pattern",
      "nodes[*].arguments.oracle_assisted"
    ],
    "reference_policy": {
      "source_references": "Only declared sources may be selected.",
      "node_references": "Only output ports of previously committed nodes may be selected.",
      "self_or_forward_reference": false,
      "effect": "A stepwise builder enforcing this policy constructs an acyclic graph with no dangling dependency reference."
    },
    "schema_grounding_policy": {
      "column_candidate_source": "planner_input.table_schema.columns",
      "serialized_shape": {"index": "non_negative_integer", "label": "exact_schema_label"},
      "fuzzy_labels": false
    },
    "argument_candidate_sources": {
      "registry_enum": "A closed list stored in an argument schema or signature argument_domains.",
      "table_schema_column": "One complete index/label pair from the planner input schema.",
      "question_derived_literal": "The pilot deterministically proposes a finite, non-gold literal list from the question and the model makes a closed choice; this is not a complete semantic domain.",
      "question_derived_text": "The pilot deterministically proposes a finite, non-gold attribute-text list from question cues plus generic fallbacks and the model makes a closed choice; the IR itself retains an open string field."
    },
    "generation_time_constraints": [
      "operator identity",
      "input role set and arity",
      "input base types",
      "backward dependency references",
      "schema column candidate identity",
      "closed argument enums",
      "tool binding",
      "declared output base type",
      "answer-eligible termination type"
    ],
    "not_closed_or_generation_constrained": [
      "FILTER predicate values are question-derived literals.",
      "Week 1 established no closed attribute ontology; the pilot's finite question-derived proposal set can omit a valid attribute.",
      "The registry cannot establish semantic correctness or document entailment for a selected literal or attribute."
    ],
    "termination": {
      "answer_eligible_types": ["String", "Number", "Date", "Boolean", "Entity", "EntitySet", "ValueSet"],
      "answer_must_reference_existing_node": true,
      "answer_must_be_source_reachable": true
    }
  },
  "operators": {
    "FILTER": {
      "status": "week2_frozen_seed",
      "week1_question_frequency": 95,
      "semantic_intent": "Select table rows satisfying one explicit schema-grounded predicate.",
      "tool_bindings": ["table.filter"],
      "schema_requirements": [
        {"argument_path": "predicate.column", "candidate_source": "table_schema_column", "check": "index_and_exact_label"}
      ],
      "determinism": {
        "expectation": "deterministic_given_inputs",
        "conditions": ["The predicate kind, value, case policy, and table snapshot are fixed."]
      },
      "failure_conditions": [
        {"code": "INVALID_PREDICATE", "when": "The predicate variant is incomplete or unsupported."},
        {"code": "SCHEMA_COLUMN_MISMATCH", "when": "The column index or label is absent or stale."},
        {"code": "EMPTY_RESULT", "when": "No row satisfies the predicate; whether this is fatal is an executor policy."}
      ],
      "generation": {
        "enabled": true,
        "argument_candidate_sources": {
          "predicate.kind": "registry_enum",
          "predicate.column": "table_schema_column",
          "predicate.value": "question_derived_literal",
          "predicate.values": "question_derived_literal",
          "predicate.case_sensitive": "registry_enum"
        },
        "open_text_arguments": []
      },
      "argument_schemas": {
        "predicate": {
          "kind": "object",
          "required": ["kind", "column"],
          "optional": ["value", "values", "case_sensitive"],
          "allow_additional": false,
          "properties": {
            "kind": {"kind": "enum", "values": ["eq", "contains", "in", "numeric_eq", "numeric_gt", "numeric_lt"]},
            "column": {"kind": "column_ref"},
            "value": {"kind": "any"},
            "values": {"kind": "array", "items": {"kind": "any"}},
            "case_sensitive": {"kind": "boolean"}
          },
          "conditional_requirements": [
            {"if": {"kind": "in"}, "require": ["values"], "forbid": ["value"]},
            {"if": {"kind": ["eq", "contains", "numeric_eq", "numeric_gt", "numeric_lt"]}, "require": ["value"], "forbid": ["values"]}
          ]
        }
      },
      "signatures": [
        {
          "id": "filter_table",
          "inputs": [{"name": "table", "types": ["Table"]}],
          "required_arguments": ["predicate"],
          "optional_arguments": [],
          "output_types": ["RowSet"]
        },
        {
          "id": "filter_rows",
          "inputs": [{"name": "rows", "types": ["RowSet"]}],
          "required_arguments": ["predicate"],
          "optional_arguments": [],
          "output_types": ["RowSet"]
        }
      ],
      "output_rules": [
        {"when_signature": ["filter_table", "filter_rows"], "output_type": "RowSet"}
      ]
    },
    "PROJECT": {
      "status": "week2_frozen_seed",
      "week1_question_frequency": 100,
      "semantic_intent": "Project text or linked entities from one schema column. Unlike v0.1, a Table may be projected directly.",
      "tool_bindings": ["table.project"],
      "schema_requirements": [
        {"argument_path": "column", "candidate_source": "table_schema_column", "check": "index_and_exact_label"}
      ],
      "determinism": {
        "expectation": "deterministic_given_inputs",
        "conditions": ["Column, mode, cardinality declaration, and table snapshot are fixed."]
      },
      "failure_conditions": [
        {"code": "SCHEMA_COLUMN_MISMATCH", "when": "The column index or label is absent or stale."},
        {"code": "EMPTY_RESULT", "when": "The input contains no projectable row or link."},
        {"code": "CARDINALITY_MISMATCH", "when": "cardinality=one but projection yields zero or multiple distinct values."}
      ],
      "generation": {
        "enabled": true,
        "argument_candidate_sources": {
          "column": "table_schema_column",
          "mode": "registry_enum",
          "cardinality": "registry_enum"
        },
        "open_text_arguments": []
      },
      "argument_schemas": {
        "column": {"kind": "column_ref"},
        "mode": {"kind": "enum", "values": ["text", "links"]},
        "cardinality": {"kind": "enum", "values": ["one", "many"]}
      },
      "signatures": [
        {
          "id": "project_rows",
          "inputs": [{"name": "rows", "types": ["Table", "Row", "RowSet"]}],
          "required_arguments": ["column", "mode", "cardinality"],
          "optional_arguments": [],
          "output_types": ["String", "Entity", "ValueSet", "EntitySet"]
        }
      ],
      "output_rules": [
        {"when_arguments": {"mode": "text", "cardinality": "one"}, "output_type": "String"},
        {"when_arguments": {"mode": "text", "cardinality": "many"}, "output_type": "ValueSet", "element_type": "String"},
        {"when_arguments": {"mode": "links", "cardinality": "one"}, "output_type": "Entity"},
        {"when_arguments": {"mode": "links", "cardinality": "many"}, "output_type": "EntitySet"}
      ]
    },
    "RETRIEVE": {
      "status": "week2_frozen_seed",
      "week1_question_frequency": 99,
      "semantic_intent": "Resolve linked entities to the fixed local HybridQA document snapshot.",
      "tool_bindings": ["document.retrieve"],
      "schema_requirements": [],
      "determinism": {
        "expectation": "deterministic_given_snapshot",
        "conditions": ["Entity links and the local request_tok snapshot are fixed; no open-web retrieval is performed."]
      },
      "failure_conditions": [
        {"code": "DOCUMENT_NOT_FOUND", "when": "No input entity link resolves in the fixed local document map."},
        {"code": "MISSING_LINK", "when": "An entity has no linked-document identifier."}
      ],
      "generation": {
        "enabled": true,
        "argument_candidate_sources": {},
        "open_text_arguments": []
      },
      "argument_schemas": {},
      "signatures": [
        {
          "id": "retrieve_entity",
          "inputs": [{"name": "entities", "types": ["Entity"]}],
          "required_arguments": [],
          "optional_arguments": [],
          "output_types": ["Document"]
        },
        {
          "id": "retrieve_entities",
          "inputs": [{"name": "entities", "types": ["EntitySet"]}],
          "required_arguments": [],
          "optional_arguments": [],
          "output_types": ["DocumentSet"]
        }
      ],
      "output_rules": [
        {"when_signature": "retrieve_entity", "output_type": "Document"},
        {"when_signature": "retrieve_entities", "output_type": "DocumentSet"}
      ]
    },
    "EXTRACT": {
      "status": "week2_frozen_seed",
      "week1_question_frequency": 99,
      "semantic_intent": "Use the fixed semantic reader interface to extract a question-specified typed attribute from linked documents without embedding an answer span in the plan.",
      "tool_bindings": ["document.extract"],
      "output_type_argument": "value_type",
      "collection_output_types": ["ValueSet", "EntitySet"],
      "schema_requirements": [],
      "determinism": {
        "expectation": "provider_dependent_then_replayable",
        "conditions": ["The reader version, decoding configuration, documents, and attribute text must be recorded; a saved result is replayable, but an external model may not be bitwise deterministic."]
      },
      "failure_conditions": [
        {"code": "UNSUPPORTED_EXTRACTION", "when": "No semantic reader is configured for the experiment."},
        {"code": "ATTRIBUTE_NOT_FOUND", "when": "The reader cannot ground the requested attribute in the supplied documents."},
        {"code": "EXTRACTION_TYPE_MISMATCH", "when": "The extracted value cannot satisfy value_type."},
        {"code": "CARDINALITY_MISMATCH", "when": "The reader result conflicts with the declared cardinality."}
      ],
      "generation": {
        "enabled": true,
        "argument_candidate_sources": {
          "attribute": "question_derived_text",
          "value_type": "registry_enum",
          "cardinality": "registry_enum"
        },
        "open_text_arguments": ["attribute"],
        "caution": "attribute has no closed global ontology. The Week 2 pilot selects from a deterministic question-derived proposal set, so selection is closed within a run but semantic coverage is not guaranteed."
      },
      "argument_schemas": {
        "attribute": {"kind": "nonempty_string"},
        "value_type": {"kind": "enum", "values": ["String", "Number", "Date", "Boolean", "Entity"]},
        "cardinality": {"kind": "enum", "values": ["one", "many"]}
      },
      "signatures": [
        {
          "id": "extract_documents",
          "inputs": [{"name": "documents", "types": ["Document", "DocumentSet"]}],
          "required_arguments": ["attribute", "value_type", "cardinality"],
          "optional_arguments": [],
          "output_types": ["String", "Number", "Date", "Boolean", "Entity", "ValueSet", "EntitySet"]
        }
      ],
      "output_rules": [
        {"when_arguments": {"cardinality": "one"}, "output_type_from_argument": "value_type"},
        {"when_arguments": {"cardinality": "many", "value_type": "Entity"}, "output_type": "EntitySet"},
        {"when_arguments": {"cardinality": "many", "value_type": ["String", "Number", "Date", "Boolean"]}, "output_type": "ValueSet", "element_type_from_argument": "value_type"}
      ]
    },
    "JOIN": {
