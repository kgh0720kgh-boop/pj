          "id": "join_rows_keys",
          "inputs": [
            {"name": "rows", "types": ["RowSet"]},
            {"name": "keys", "types": ["Entity", "EntitySet", "String", "ValueSet"]}
          ],
          "required_arguments": ["right_column", "match"],
          "optional_arguments": [],
          "output_types": ["RowSet"]
        }
      ],
      "output_rules": [
        {"when_signature": "join_rows_keys", "output_type": "RowSet"}
      ]
    },
