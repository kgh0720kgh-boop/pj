    "COMPARE": {
      "status": "week2_frozen_seed",
      "week1_question_frequency": 5,
      "semantic_intent": "Compare a same-typed scalar pair or select a value/entity key from a keyed value collection under a closed relation.",
      "tool_bindings": ["calculator.compare"],
