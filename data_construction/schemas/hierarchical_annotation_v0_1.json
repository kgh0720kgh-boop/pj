        },
        "differences_from_representative": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "valid_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessment": {
          "$ref": "#/$defs/alternative_plan_assessment"
        },
        "ambiguity": {
          "$ref": "common_definitions_v0_1.json#/$defs/ambiguity"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation_kind": {
                "const": "abstract_topology"
              }
            },
            "required": [
              "representation_kind"
            ]
          },
          "then": {
            "required": [
              "abstract_topology"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation_kind": {
                "const": "operator_topology"
              }
            },
            "required": [
              "representation_kind"
            ]
          },
          "then": {
            "required": [
              "operator_topology"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation_kind": {
                "const": "grounded_operator_topology"
              }
            },
            "required": [
              "representation_kind"
            ]
          },
          "then": {
            "required": [
              "operator_topology",
              "grounding"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation_kind": {
                "const": "execution_graph_reference"
              }
            },
            "required": [
              "representation_kind"
            ]
          },
          "then": {
            "required": [
              "execution_graph"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "prediction_view_contract": {
      "type": "object",
      "required": [
        "task",
        "input_paths",
        "target_paths",
        "prohibited_input_paths"
      ],
      "properties": {
        "task": {
          "enum": [
            "question_to_semantics",
            "semantics_to_operator_topology",
            "operator_topology_to_grounding",
            "question_environment_to_execution_graph",
            "execution_evaluation"
          ]
        },
        "input_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common_definitions_v0_1.json#/$defs/json_pointer"
          },
          "uniqueItems": true
        },
        "target_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common_definitions_v0_1.json#/$defs/json_pointer"
          },
          "uniqueItems": true
        },
        "prohibited_input_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common_definitions_v0_1.json#/$defs/json_pointer"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "boundary_leakage_audit": {
      "type": "object",
      "required": [
        "boundary",
        "status",
        "violations"
      ],
      "properties": {
        "boundary": {
          "enum": [
            "question_to_semantics",
            "semantics_to_abstract_topology",
            "abstract_to_operator_topology",
            "operator_topology_to_grounding",
            "grounding_to_execution_graph",
            "locked_eval_isolation"
          ]
        },
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "checker_id": {
          "type": "string",
          "minLength": 1
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "common_definitions_v0_1.json#/$defs/leakage_violation"
          }
        },
        "input_view_artifact": {
          "$ref": "common_definitions_v0_1.json#/$defs/artifact_reference"
        },
        "audit_result_artifact": {
          "$ref": "common_definitions_v0_1.json#/$defs/artifact_reference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            },
            "required": [
              "checked_at",
              "checker_id"
            ]
          },
          "else": {
            "properties": {
              "violations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "checked_at",
              "checker_id",
              "input_view_artifact",
              "audit_result_artifact"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "leakage_controls": {
      "type": "object",
      "required": [
        "policy_version",
        "prediction_view_contracts",
        "boundary_audits",
        "early_layer_answer_exposure"
      ],
      "properties": {
        "policy_version": {
          "const": "hierarchical_leakage_policy_v0_1"
        },
        "prediction_view_contracts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/prediction_view_contract"
          },
          "allOf": [
            {"contains": {"properties": {"task": {"const": "question_to_semantics"}}, "required": ["task"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"task": {"const": "semantics_to_operator_topology"}}, "required": ["task"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"task": {"const": "operator_topology_to_grounding"}}, "required": ["task"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"task": {"const": "question_environment_to_execution_graph"}}, "required": ["task"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"task": {"const": "execution_evaluation"}}, "required": ["task"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "boundary_audits": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/boundary_leakage_audit"
          },
          "allOf": [
            {"contains": {"properties": {"boundary": {"const": "question_to_semantics"}}, "required": ["boundary"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"boundary": {"const": "semantics_to_abstract_topology"}}, "required": ["boundary"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"boundary": {"const": "abstract_to_operator_topology"}}, "required": ["boundary"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"boundary": {"const": "operator_topology_to_grounding"}}, "required": ["boundary"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"boundary": {"const": "grounding_to_execution_graph"}}, "required": ["boundary"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"boundary": {"const": "locked_eval_isolation"}}, "required": ["boundary"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "early_layer_answer_exposure": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "locked_eval_controls": {
      "type": "object",
      "required": [
        "prompt_tuning_allowed",
        "rubric_tuning_allowed",
        "operator_vocabulary_tuning_allowed",
        "split_membership_verified",
        "historical_exposure_checked"
      ],
      "properties": {
        "prompt_tuning_allowed": {
          "type": "boolean"
        },
        "rubric_tuning_allowed": {
          "type": "boolean"
        },
        "operator_vocabulary_tuning_allowed": {
          "type": "boolean"
        },
        "split_membership_verified": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "historical_exposure_checked": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "split_manifest_artifact": {
          "$ref": "common_definitions_v0_1.json#/$defs/artifact_reference"
        },
        "historical_exposure_manifest_artifact": {
          "$ref": "common_definitions_v0_1.json#/$defs/artifact_reference"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
