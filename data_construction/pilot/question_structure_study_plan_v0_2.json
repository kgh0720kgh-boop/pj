  },
  "research_hypotheses": [
    "HybridQA question text contains recurrent environment-independent semantic dependency backbones.",
    "A small provisional semantic-role vocabulary plus composition can cover many questions without forcing every question into one graph.",
    "The rate of genuinely new recurrent structures should decline as the question pool expands if a compact backbone system is feasible.",
    "Environment-aware and executable graphs should be treated as later realizations of a question-level backbone rather than as the same object."
  ],
  "primary_research_questions": [
    "How many deterministic semantic-DAG and topology families recur under a frozen question-only extractor?",
    "How much of the new-question expansion is covered by families observed in the contract-development prefix?",
    "How much apparent novelty disappears under deterministic same-role linear split/merge contraction?",
    "Does the provisional role vocabulary require OTHER often enough to justify a new version?",
    "Which recurrent and rare backbones should later be realized and executed in the HybridQA environment?"
  ],
  "phase_order": [
    "scale_0_preserve_and_reinterpret_direction_finding_diagnostic",
    "scale_1_freeze_question_only_extractor_normalizer_and_metrics",
    "scale_2_cumulative_n100_extraction_and_saturation_analysis",
    "scale_3_unchanged_n300_expansion_if_triggered",
    "scale_4_unchanged_n1000_expansion_if_triggered",
    "scale_5_candidate_backbone_library_and_composition_rules",
    "scale_6_representative_environment_realization",
    "scale_7_grounding_execution_and_answer_recovery",
    "scale_8_optional_targeted_human_audit_if_needed_for_claims"
  ],
  "sampling_contract": {
    "dataset": "HybridQA",
    "source_split": "dev",
