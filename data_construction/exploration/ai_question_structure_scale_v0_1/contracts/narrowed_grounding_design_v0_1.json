    "operator_unit": "exactly_one_argument_disposition_per_original_operator_node_in_every_grounding_alternative",
    "source_candidate_graph": "immutable_hash_bound_no_node_edge_mapping_or_slot_changes",
    "slot_statuses": ["resolved", "ambiguous", "unavailable", "abstained"],
