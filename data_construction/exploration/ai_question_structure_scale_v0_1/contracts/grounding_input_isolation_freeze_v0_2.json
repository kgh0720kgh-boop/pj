  "design": {
    "aggregate_probe_rule": "Apply branch_order per context. The known-injection and opaque controls must STOP and BLOCK respectively; those expected outcomes are not failures of the suite. Any unexpected control outcome stops the suite; missing captures make it incomplete; an unverifiable closed-context case blocks it. Only all three expected outcomes plus independently verified host evidence qualify the adapter for consideration of a separate plan. Expected control results never qualify the contaminated or opaque contexts themselves.",
    "branch_order": [
      {
        "decision": "STOP_INPUT_ISOLATION_FAILURE",
        "when": "in this context: known excluded content, premature research delivery, contradictory or tampered evidence, replay, or forbidden retrieval"
      },
      {
        "decision": "BLOCKED_UNVERIFIABLE_CONTEXT",
        "when": "no known failure but any inventory boundary, source evidence, provenance binding or author exposure status is unknown/unverifiable"
      },
      {
        "decision": "INCOMPLETE_ISOLATION_PROBE",
        "when": "no known failure/unknown boundary, but any planned capture or control result is missing"
      },
      {
        "decision": "QUALIFIED_FOR_SEPARATE_PLAN_ONLY",
        "when": "this context has complete bound evidence and no preceding stop/block/incomplete condition; this is transport-scoped diagnostic qualification, never research authorization"
      }
    ],
    "evidence_boundary": {
      "grounding_quality_evaluated": false,
      "human_evidence": 0,
      "new_model_calls": 0,
      "semantic_gold": false,
      "transport_qualified": false
    },
    "identity_migration": {
      "hash_rule": "Each field hashes the exact bytes of its explicitly named component. Define payload canonicalization separately before implementation; do not alias protocol and guide identities.",
      "new_version_required_fields": [
        "protocol_sha256",
        "author_guide_sha256",
        "response_schema_sha256",
        "packet_payload_sha256",
        "input_manifest_sha256"
      ],
      "old_bytes_changed": false,
      "old_packet_protocol_sha256": "Preserved v0.1 field hashes the author guide; protocol itself remains transitively bound. This is a naming defect, not byte corruption."
    },
    "inventory_categories": [
      "explicit_messages_and_attachments",
      "global_and_project_instructions",
      "conversation_history_and_resume_state",
      "memory_and_retrieval",
      "skills_metadata_and_content",
      "tool_definitions_and_tool_results",
      "workspace_files_and_environment_metadata",
      "connectors_and_external_sources",
      "platform_managed_context"
    ],
    "inventory_contract": {
      "delivery_statuses": [
        "included",
        "disabled_verified",
        "unknown"
      ],
      "included_rule": "Every included host-controlled payload requires a byte hash, role, sequence, source class, and precommitted allowlist match. Content must contain no study results, question text, graph, binding, answer or historical label in this diagnostic.",
      "per_category_required": [
        "category",
        "visibility_status",
        "delivery_status",
        "evidence_reference",
        "content_identity_or_unavailability_reason",
        "excluded_research_content_status"
      ],
      "privacy_rule": "Keep secrets and machine-local paths out of portable receipts; use logical resource identities. Do not publish privileged platform text.",
      "unknown_rule": "Missing category, unsupported suppression setting, missing audit evidence or uncertain project-content boundary blocks; do not replace unknown with empty.",
      "visibility_statuses": [
        "host_captured",
        "independently_documented_boundary",
        "unknown"
      ]
    },
    "preserved_failure": {
      "accepted_candidate_records": 0,
      "decision": "STOP_TECHNICAL_OR_LEAKAGE_FAILURE",
      "disposition": "immutable_no_repair_relabel_retry_or_semantic_tuning",
      "raw_contexts_known_exposed": 6
    },
    "probe_contract": {
      "actual_platform_probe_count": 0,
      "cases": [
        {
          "case_id": "synthetic_closed_context",
          "description": "Only frozen neutral diagnostic inputs; qualification additionally requires complete independently evidenced host boundary, never just canary absence.",
          "expected": "QUALIFIED_FOR_SEPARATE_PLAN_ONLY"
        },
        {
          "case_id": "synthetic_known_injection",
          "description": "Deliberately inject an approved synthetic exclusion marker through a project-instruction-like source; never use real AGENTS or study facts.",
          "expected": "STOP_INPUT_ISOLATION_FAILURE"
        },
        {
          "case_id": "synthetic_opaque_boundary",
          "description": "Withhold a controlled inventory component; the verifier must refuse clearance even if the author claims clean.",
          "expected": "BLOCKED_UNVERIFIABLE_CONTEXT"
        }
      ],
      "future_probe_gate": "If no available authorized transport can supply sufficient host evidence, record BLOCKED_UNVERIFIABLE_CONTEXT before model dispatch and request the missing transport/authority; never fabricate a receipt.",
      "max_launches_per_case": 1,
      "positive_control_limit": "Detection of a known marker tests one path only; non-detection of an unknown marker cannot prove total isolation.",
      "research_payloads_allowed": false,
      "retry_policy": "Preserve failed or incomplete first captures; no outcome-conditioned replacement. Changing adapter or protocol requires a new version and output-absent freeze."
    },
    "purpose": "Repair research input-delivery isolation, not semantic grounding rules.",
    "receipt_contract": {
      "binding_rule": "Host capture and author disclosure must bind the same unique context/nonce, exact configuration, ordered delivered bytes and frozen plan. Host evidence must have a verifiable origin outside the author's response; a hand-filled coordinator attestation is not sufficient.",
      "prior_exposure_values": [
        "no_known_exposure",
        "known_exposed",
        "unknown"
      ],
      "provenance_rule": "Record actual transport/model identifiers; exact revision, seed and backend raw-stream capture must explicitly say unavailable when not exposed. Self-report is not backend authentication.",
      "replay_rule": "Never reuse a clearance across contexts, resumed threads, config/tool changes or added inputs. Every future research context requires its own pre-packet gate and post-delivery audit.",
      "required_author_fields": [
        "context_id",
        "launch_nonce",
        "prior_exposure",
        "unexpected_input_categories",
        "capture_limitations"
      ],
      "required_host_fields": [
        "contract_sha256",
