{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment_realization_outcome_schema_v0_2.json",
  "title": "Representative environment-realization outcome v0.2",
  "description": "A five-signal instance outcome that distinguishes an open operator notation from a selected vocabulary, preserves variant-qualified realization results, and treats logical signal separation separately from author independence.",
  "type": "object",
  "required": [
    "schema_version",
    "outcome_id",
    "run_id",
    "selection_id",
    "selection_index",
    "question_id",
    "family_id",
    "contracted_signature_sha256",
    "record_status",
    "assessment_scope",
    "source_bindings",
    "backbone_adequacy",
    "environment_operator_realization",
    "grounding",
    "execution",
    "answer_recovery",
    "independence_contract",
    "evidence_boundary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "environment_realization_outcome_v0_2"
    },
    "outcome_id": {
      "$ref": "#/$defs/stable_id"
    },
    "run_id": {
      "$ref": "#/$defs/stable_id"
    },
    "selection_id": {
      "const": "hybridqa_n300_candidate_backbone_coverage_sample_v0_1"
    },
    "selection_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 71
    },
    "question_id": {
      "$ref": "#/$defs/stable_id"
    },
    "family_id": {
      "type": "string",
      "pattern": "^cbf_v0_1:[0-9a-f]{64}$"
    },
    "contracted_signature_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "record_status": {
      "enum": [
        "initialized_not_evaluated",
        "in_progress",
        "complete"
      ]
    },
    "assessment_scope": {
      "const": "selected_question_environment_instance_only"
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact_binding"
      }
    },
    "backbone_adequacy": {
      "$ref": "#/$defs/backbone_adequacy"
    },
    "environment_operator_realization": {
      "$ref": "#/$defs/environment_operator_realization"
    },
    "grounding": {
      "$ref": "#/$defs/grounding"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "answer_recovery": {
      "$ref": "#/$defs/answer_recovery"
    },
    "independence_contract": {
      "$ref": "#/$defs/independence_contract"
    },
    "evidence_boundary": {
      "$ref": "#/$defs/evidence_boundary"
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonempty_text"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "initialized_not_evaluated"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "properties": {
          "backbone_adequacy": {
            "properties": {
              "status": {
                "const": "not_evaluated"
              }
            }
          },
          "environment_operator_realization": {
            "properties": {
              "status": {
                "const": "not_evaluated"
              }
            }
          },
          "grounding": {
            "properties": {
              "status": {
                "const": "not_evaluated"
              }
            }
          },
          "execution": {
            "properties": {
              "status": {
                "const": "not_evaluated"
              }
            }
          },
          "answer_recovery": {
            "properties": {
              "status": {
                "const": "not_evaluated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "complete"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "properties": {
          "backbone_adequacy": {
            "properties": {
              "status": {
                "not": {
                  "const": "not_evaluated"
                }
              }
            }
          },
          "environment_operator_realization": {
            "properties": {
              "status": {
                "not": {
                  "const": "not_evaluated"
                }
              }
            }
          },
          "grounding": {
            "properties": {
              "status": {
                "not": {
                  "const": "not_evaluated"
                }
              }
            }
          },
          "execution": {
            "properties": {
              "status": {
                "not": {
                  "const": "not_evaluated"
                }
              }
            }
          },
          "answer_recovery": {
            "properties": {
              "status": {
                "not": {
                  "const": "not_evaluated"
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "maxLength": 256
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "nullable_text": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_boolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullable_stable_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/stable_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment_status": {
      "enum": [
        "not_evaluated",
        "pass",
        "partial",
        "fail",
        "indeterminate",
        "not_applicable"
      ]
    },
    "artifact_binding": {
      "type": "object",
      "required": [
        "artifact_role",
        "repository_relative_path",
        "sha256",
        "record_id"
      ],
      "properties": {
        "artifact_role": {
          "$ref": "#/$defs/stable_id"
        },
        "repository_relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "maxLength": 1024
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_id": {
          "$ref": "#/$defs/nullable_stable_id"
        }
      },
      "additionalProperties": false
    },
    "signal_evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/artifact_binding"
      }
    },
    "code_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stable_id"
      }
    },
    "backbone_variant_id": {
      "oneOf": [
        {
          "const": "primary"
        },
        {
          "type": "string",
          "pattern": "^alt[1-9][0-9]*$"
        }
      ]
    },
    "backbone_node_id": {
      "type": "string",
      "pattern": "^n[1-9][0-9]*$"
    },
    "backbone_adequacy": {
      "type": "object",
      "description": "Whether the frozen question-only candidate set adequately expresses the question semantics. It is not inferred from operator realization or execution.",
      "required": [
        "status",
        "candidate_backbone_adequate",
        "required_change_codes",
        "evidence_references",
        "notes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/assessment_status"
        },
        "candidate_backbone_adequate": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "required_change_codes": {
          "$ref": "#/$defs/code_list"
        },
        "evidence_references": {
          "$ref": "#/$defs/signal_evidence"
        },
        "notes": {
          "$ref": "#/$defs/nullable_text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_evaluated",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_backbone_adequate": {
                "type": "null"
              },
              "required_change_codes": {
                "maxItems": 0
              },
              "evidence_references": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_backbone_adequate": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "fail"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_backbone_adequate": {
                "const": false
              },
              "required_change_codes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "indeterminate"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_backbone_adequate": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "variant_realization_result": {
      "type": "object",
      "required": [
        "backbone_variant_id",
        "status",
        "blocking_unsupported_node_ids",
        "candidate_count"
      ],
      "properties": {
        "backbone_variant_id": {
          "$ref": "#/$defs/backbone_variant_id"
        },
        "status": {
          "enum": [
            "fully_realized",
            "partially_realized",
            "unavailable",
            "indeterminate"
          ]
        },
        "blocking_unsupported_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/backbone_node_id"
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "fully_realized"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "blocking_unsupported_node_ids": {
                "maxItems": 0
              },
              "candidate_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partially_realized"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "blocking_unsupported_node_ids": {
                "minItems": 1
              },
              "candidate_count": {
                "const": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "environment_operator_realization": {
      "type": "object",
      "description": "Whether an ungrounded open-notation operator topology was authored for at least one candidate variant. This is not a final-vocabulary, grounding, or execution result.",
      "required": [
        "status",
        "complete_realization_available",
        "operator_notation_id",
        "final_operator_vocabulary_selected",
        "realization_record_id",
        "variant_realization_results",
        "realization_candidate_count",
        "unresolved_issue_count",
        "evidence_references",
        "notes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/assessment_status"
        },
        "complete_realization_available": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "operator_notation_id": {
          "$ref": "#/$defs/nullable_stable_id"
        },
        "final_operator_vocabulary_selected": {
          "const": false
        },
        "realization_record_id": {
          "$ref": "#/$defs/nullable_stable_id"
        },
        "variant_realization_results": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant_realization_result"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "backbone_variant_id": {
                    "const": "primary"
                  }
                },
                "required": [
                  "backbone_variant_id"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "backbone_variant_id": {
                    "const": "alt1"
                  }
                },
                "required": [
                  "backbone_variant_id"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "backbone_variant_id": {
                    "const": "alt2"
                  }
                },
                "required": [
                  "backbone_variant_id"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "backbone_variant_id": {
                    "const": "alt3"
                  }
                },
                "required": [
                  "backbone_variant_id"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "realization_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "unresolved_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_references": {
          "$ref": "#/$defs/signal_evidence"
        },
        "notes": {
          "$ref": "#/$defs/nullable_text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_evaluated",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "complete_realization_available": {
                "type": "null"
              },
              "operator_notation_id": {
                "type": "null"
              },
              "realization_record_id": {
                "type": "null"
              },
              "variant_realization_results": {
                "maxItems": 0
              },
              "realization_candidate_count": {
                "const": 0
              },
              "unresolved_issue_count": {
                "const": 0
              },
              "evidence_references": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "partial",
                  "fail",
                  "indeterminate"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "realization_record_id": {
                "$ref": "#/$defs/stable_id"
              },
              "variant_realization_results": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "complete_realization_available": {
                "const": true
              },
              "operator_notation_id": {
                "$ref": "#/$defs/stable_id"
              },
              "variant_realization_results": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "fully_realized"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "realization_candidate_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "complete_realization_available": {
                "const": false
              },
              "operator_notation_id": {
                "$ref": "#/$defs/stable_id"
              },
              "variant_realization_results": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "partially_realized"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "const": "fully_realized"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              },
              "realization_candidate_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fail"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "complete_realization_available": {
                "const": false
              },
              "variant_realization_results": {
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "realization_candidate_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "indeterminate"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "complete_realization_available": {
                "type": "null"
              },
              "variant_realization_results": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "indeterminate"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "enum": [
                          "fully_realized",
                          "partially_realized"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "realization_candidate_count": {
                "const": 0
              }
            },
            "required": [
              "realization_candidate_count"
            ]
          },
          "then": {
            "properties": {
              "operator_notation_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "realization_candidate_count": {
                "minimum": 1
              }
            },
            "required": [
              "realization_candidate_count"
            ]
          },
          "then": {
            "properties": {
              "operator_notation_id": {
                "$ref": "#/$defs/stable_id"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "grounding": {
      "type": "object",
      "required": [
        "status",
        "all_required_inputs_grounded",
        "grounding_record_id",
        "grounded_item_count",
        "ungrounded_item_count",
        "failure_codes",
        "evidence_references",
        "notes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/assessment_status"
        },
        "all_required_inputs_grounded": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "grounding_record_id": {
          "$ref": "#/$defs/nullable_stable_id"
        },
        "grounded_item_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ungrounded_item_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failure_codes": {
          "$ref": "#/$defs/code_list"
        },
        "evidence_references": {
          "$ref": "#/$defs/signal_evidence"
        },
        "notes": {
          "$ref": "#/$defs/nullable_text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_evaluated",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "all_required_inputs_grounded": {
                "type": "null"
              },
              "grounding_record_id": {
                "type": "null"
              },
              "grounded_item_count": {
                "type": "null"
              },
              "ungrounded_item_count": {
                "type": "null"
              },
              "failure_codes": {
                "maxItems": 0
              },
              "evidence_references": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "all_required_inputs_grounded": {
                "const": true
              },
              "ungrounded_item_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fail"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "all_required_inputs_grounded": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "all_required_inputs_grounded": {
                "const": true
              }
            },
            "required": [
              "all_required_inputs_grounded"
            ]
          },
          "then": {
            "properties": {
              "ungrounded_item_count": {
                "const": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "executable",
        "execution_succeeded",
        "execution_record_id",
        "failure_codes",
        "evidence_references",
        "notes"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/assessment_status"
        },
        "executable": {
          "$ref": "#/$defs/nullable_boolean"
        },
