{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_backbone_family_schema_v0_1.json",
  "title": "Candidate question-only semantic-backbone family v0.1",
  "description": "One non-gold candidate family deterministically derived from the frozen cumulative N=300 question-only AI exploration.",
  "type": "object",
  "required": [
    "schema_version", "library_id", "evidence_class", "candidate_status",
    "family_id", "contracted_signature_sha256", "frequency_rank",
    "evidence_tier", "frequency_stratum", "frequency",
    "canonical_contracted_graph", "members", "support", "crosswalks",
    "observed_composition", "evidence", "representative_selection", "caveats"
  ],
  "properties": {
    "schema_version": {"const": "candidate_backbone_family_v0_1"},
    "library_id": {"const": "hybridqa_n300_contracted_candidate_backbone_library_v0_1"},
    "evidence_class": {"const": "ai_exploratory_non_human_non_gold"},
    "candidate_status": {"const": "candidate_non_gold_not_established"},
    "family_id": {"type": "string", "pattern": "^cbf_v0_1:[0-9a-f]{64}$"},
    "contracted_signature_sha256": {"$ref": "#/$defs/sha256"},
    "frequency_rank": {"type": "integer", "minimum": 1, "maximum": 30},
    "evidence_tier": {"$ref": "#/$defs/evidence_tier"},
    "frequency_stratum": {"$ref": "#/$defs/frequency_stratum"},
    "frequency": {"$ref": "#/$defs/frequency"},
    "canonical_contracted_graph": {"$ref": "#/$defs/semantic_canonical_graph"},
    "members": {
      "type": "array", "minItems": 1, "maxItems": 300,
      "items": {"$ref": "#/$defs/member"}
    },
    "support": {"$ref": "#/$defs/support"},
    "crosswalks": {"$ref": "#/$defs/crosswalks"},
    "observed_composition": {"$ref": "#/$defs/observed_composition"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "representative_selection": {"$ref": "#/$defs/representative_selection"},
    "caveats": {"$ref": "#/$defs/caveats"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_id": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "maxLength": 256
    },
    "question_id": {"$ref": "#/$defs/stable_id"},
    "semantic_role": {
      "enum": [
        "RESOLVE_REFERENT", "ACQUIRE_PROPERTY", "COMPARE", "AGGREGATE",
        "ORDER_OR_EXTREMUM", "DERIVE", "VERIFY", "COMBINE", "OTHER"
      ]
    },
    "uncertainty_tag": {
      "enum": [
        "REFERENT", "CARDINALITY", "SCOPE", "TEMPORAL", "MEASUREMENT",
        "COMPARISON", "GRAMMAR", "OTHER"
      ]
    },
    "evidence_tier": {"enum": ["recurrent", "doubleton", "singleton"]},
    "frequency_stratum": {
      "enum": [
        "singleton_1", "doubleton_2", "low_recurrent_3_9",
        "medium_recurrent_10_19", "high_recurrent_20_99", "dominant_100_plus"
      ]
    },
    "edge": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 7},
        {"type": "integer", "minimum": 0, "maximum": 7}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "semantic_canonical_graph": {
      "type": "object",
      "required": ["labels", "edges"],
      "properties": {
        "labels": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {"$ref": "#/$defs/semantic_role"}
        },
        "edges": {
          "type": "array", "maxItems": 56, "uniqueItems": true,
          "items": {"$ref": "#/$defs/edge"}
        }
      },
      "additionalProperties": false
    },
    "topology_canonical_graph": {
      "type": "object",
      "required": ["labels", "edges"],
      "properties": {
        "labels": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {"const": "NODE"}
        },
        "edges": {
          "type": "array", "maxItems": 56, "uniqueItems": true,
          "items": {"$ref": "#/$defs/edge"}
        }
      },
      "additionalProperties": false
    },
    "task_canonical": {
      "type": "object",
      "required": ["answer_kind", "answer_cardinality", "graph"],
      "properties": {
        "answer_kind": {
          "enum": [
            "entity", "attribute_value", "numeric_value", "date_time", "boolean",
            "textual_explanation", "other", "unknown"
          ]
        },
        "answer_cardinality": {"enum": ["one", "multiple", "unknown"]},
        "graph": {"$ref": "#/$defs/semantic_canonical_graph"}
      },
      "additionalProperties": false
    },
    "status_counts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "complete": {"type": "integer", "minimum": 1, "maximum": 300},
        "uncertain": {"type": "integer", "minimum": 1, "maximum": 300}
      },
      "additionalProperties": false
    },
    "frequency": {
      "type": "object",
      "required": [
        "cumulative_n300_question_count", "n100_prefix_question_count",
        "new200_expansion_question_count", "cumulative_question_rate",
        "status_counts", "uncertainty_present_question_count",
        "alternative_graph_question_count"
      ],
      "properties": {
        "cumulative_n300_question_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "n100_prefix_question_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "new200_expansion_question_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "cumulative_question_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "status_counts": {"$ref": "#/$defs/status_counts"},
        "uncertainty_present_question_count": {"type": "integer", "minimum": 0, "maximum": 300},
        "alternative_graph_question_count": {"type": "integer", "minimum": 0, "maximum": 300}
      },
      "additionalProperties": false
    },
    "signatures": {
      "type": "object",
      "required": ["fine_semantic_dag", "contracted_semantic_dag", "topology_shape", "task"],
      "properties": {
        "fine_semantic_dag": {"$ref": "#/$defs/sha256"},
        "contracted_semantic_dag": {"$ref": "#/$defs/sha256"},
        "topology_shape": {"$ref": "#/$defs/sha256"},
        "task": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": [
        "question_id", "question_view_sha256", "committed_position", "source_slice",
        "producer_partition", "cumulative_ten_question_block_number",
        "new200_relative_ten_question_block_number", "status", "uncertainty_present",
        "uncertainty_tags", "has_alternative_graph", "signatures"
      ],
      "properties": {
        "question_id": {"$ref": "#/$defs/question_id"},
        "question_view_sha256": {"$ref": "#/$defs/sha256"},
        "committed_position": {"type": "integer", "minimum": 1, "maximum": 300},
        "source_slice": {"enum": ["n100_prefix", "new200_expansion"]},
        "producer_partition": {"type": "string", "pattern": "^partition_0[1-8]$"},
        "cumulative_ten_question_block_number": {"type": "integer", "minimum": 1, "maximum": 30},
        "new200_relative_ten_question_block_number": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 20},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["complete", "uncertain"]},
        "uncertainty_present": {"type": "boolean"},
        "uncertainty_tags": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/uncertainty_tag"}
        },
        "has_alternative_graph": {"type": "boolean"},
        "signatures": {"$ref": "#/$defs/signatures"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_slice": {"const": "n100_prefix"}},
            "required": ["source_slice"]
          },
          "then": {
            "properties": {
              "committed_position": {"type": "integer", "minimum": 1, "maximum": 100},
              "cumulative_ten_question_block_number": {
                "type": "integer", "minimum": 1, "maximum": 10
              },
              "new200_relative_ten_question_block_number": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "committed_position": {"type": "integer", "minimum": 101, "maximum": 300},
              "cumulative_ten_question_block_number": {
                "type": "integer", "minimum": 11, "maximum": 30
              },
              "new200_relative_ten_question_block_number": {
                "type": "integer", "minimum": 1, "maximum": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {"uncertainty_present": {"const": true}},
            "required": ["uncertainty_present"]
          },
          "then": {
            "properties": {
              "status": {"const": "uncertain"},
              "uncertainty_tags": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "status": {"const": "complete"},
              "uncertainty_tags": {"maxItems": 0}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "partition_count_map": {
      "type": "object",
      "properties": {
        "partition_01": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_02": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_03": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_04": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_05": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_06": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_07": {"type": "integer", "minimum": 1, "maximum": 300},
        "partition_08": {"type": "integer", "minimum": 1, "maximum": 300}
      },
      "additionalProperties": false
    },
    "block_count": {
      "type": "object",
      "required": ["block_number", "question_count"],
      "properties": {
        "block_number": {"type": "integer", "minimum": 1, "maximum": 30},
        "question_count": {"type": "integer", "minimum": 1, "maximum": 300}
      },
      "additionalProperties": false
    },
    "new200_block_count": {
      "type": "object",
      "required": ["block_number", "question_count"],
      "properties": {
        "block_number": {"type": "integer", "minimum": 1, "maximum": 20},
        "question_count": {"type": "integer", "minimum": 1, "maximum": 200}
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": [
        "producer_partition_counts", "n100_prefix_producer_partition_counts",
        "new200_expansion_producer_partition_counts", "producer_partition_support_count",
        "cumulative_ten_question_block_counts", "cumulative_ten_question_block_support_count",
        "new200_relative_ten_question_block_counts",
        "new200_relative_ten_question_block_support_count"
      ],
      "properties": {
        "producer_partition_counts": {"$ref": "#/$defs/partition_count_map"},
        "n100_prefix_producer_partition_counts": {"$ref": "#/$defs/partition_count_map"},
        "new200_expansion_producer_partition_counts": {"$ref": "#/$defs/partition_count_map"},
        "producer_partition_support_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "cumulative_ten_question_block_counts": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {"$ref": "#/$defs/block_count"}
        },
        "cumulative_ten_question_block_support_count": {
          "type": "integer", "minimum": 1, "maximum": 30
        },
        "new200_relative_ten_question_block_counts": {
          "type": "array", "maxItems": 20,
          "description": "Expansion-relative blocks: block 1 is committed positions 101-110.",
          "items": {"$ref": "#/$defs/new200_block_count"}
        },
        "new200_relative_ten_question_block_support_count": {
          "type": "integer", "minimum": 0, "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "semantic_crosswalk": {
      "type": "object",
      "required": ["signature_sha256", "canonical", "question_count", "question_ids"],
      "properties": {
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "canonical": {"$ref": "#/$defs/semantic_canonical_graph"},
        "question_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "question_ids": {
          "type": "array", "minItems": 1, "maxItems": 300, "uniqueItems": true,
          "items": {"$ref": "#/$defs/question_id"}
        }
      },
      "additionalProperties": false
    },
    "topology_crosswalk": {
      "type": "object",
      "required": ["signature_sha256", "canonical", "question_count", "question_ids"],
      "properties": {
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "canonical": {"$ref": "#/$defs/topology_canonical_graph"},
        "question_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "question_ids": {
          "type": "array", "minItems": 1, "maxItems": 300, "uniqueItems": true,
          "items": {"$ref": "#/$defs/question_id"}
        }
      },
      "additionalProperties": false
    },
    "task_crosswalk": {
      "type": "object",
      "required": ["signature_sha256", "canonical", "question_count", "question_ids"],
      "properties": {
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "canonical": {"$ref": "#/$defs/task_canonical"},
        "question_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "question_ids": {
          "type": "array", "minItems": 1, "maxItems": 300, "uniqueItems": true,
          "items": {"$ref": "#/$defs/question_id"}
        }
      },
      "additionalProperties": false
    },
    "crosswalks": {
      "type": "object",
      "required": ["fine_semantic_dag", "topology_shape", "task"],
      "properties": {
        "fine_semantic_dag": {
          "type": "array", "minItems": 1, "maxItems": 39,
          "items": {"$ref": "#/$defs/semantic_crosswalk"}
        },
        "topology_shape": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {"$ref": "#/$defs/topology_crosswalk"}
        },
        "task": {
          "type": "array", "minItems": 1, "maxItems": 70,
          "items": {"$ref": "#/$defs/task_crosswalk"}
        }
      },
      "additionalProperties": false
    },
    "role_count_map": {
      "type": "object",
      "patternProperties": {
        "^(RESOLVE_REFERENT|ACQUIRE_PROPERTY|COMPARE|AGGREGATE|ORDER_OR_EXTREMUM|DERIVE|VERIFY|COMBINE|OTHER)$": {
          "type": "integer", "minimum": 1, "maximum": 2400
        }
      },
      "additionalProperties": false
    },
    "transition_count_map": {
      "type": "object",
      "patternProperties": {
        "^(RESOLVE_REFERENT|ACQUIRE_PROPERTY|COMPARE|AGGREGATE|ORDER_OR_EXTREMUM|DERIVE|VERIFY|COMBINE|OTHER)->(RESOLVE_REFERENT|ACQUIRE_PROPERTY|COMPARE|AGGREGATE|ORDER_OR_EXTREMUM|DERIVE|VERIFY|COMBINE|OTHER)$": {
          "type": "integer", "minimum": 1, "maximum": 16800
        }
      },
      "additionalProperties": false
    },
    "observed_composition": {
      "type": "object",
      "required": [
        "edge_direction", "canonical_contracted_node_count", "canonical_contracted_edge_count",
        "canonical_contracted_role_counts",
        "canonical_contracted_directed_role_transition_counts",
        "uncontracted_member_role_node_counts",
        "uncontracted_member_directed_dependency_role_transition_counts",
        "uncontracted_composition_used_to_define_family"
      ],
      "properties": {
        "edge_direction": {"const": "dependency_role_to_dependent_role"},
        "canonical_contracted_node_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "canonical_contracted_edge_count": {"type": "integer", "minimum": 0, "maximum": 56},
        "canonical_contracted_role_counts": {"$ref": "#/$defs/role_count_map"},
        "canonical_contracted_directed_role_transition_counts": {"$ref": "#/$defs/transition_count_map"},
        "uncontracted_member_role_node_counts": {"$ref": "#/$defs/role_count_map"},
        "uncontracted_member_directed_dependency_role_transition_counts": {
          "$ref": "#/$defs/transition_count_map"
        },
        "uncontracted_composition_used_to_define_family": {"const": false}
      },
      "additionalProperties": false
    },
    "uncertainty_tag_count_map": {
      "type": "object",
      "properties": {
        "REFERENT": {"type": "integer", "minimum": 1, "maximum": 300},
        "CARDINALITY": {"type": "integer", "minimum": 1, "maximum": 300},
        "SCOPE": {"type": "integer", "minimum": 1, "maximum": 300},
        "TEMPORAL": {"type": "integer", "minimum": 1, "maximum": 300},
        "MEASUREMENT": {"type": "integer", "minimum": 1, "maximum": 300},
        "COMPARISON": {"type": "integer", "minimum": 1, "maximum": 300},
        "GRAMMAR": {"type": "integer", "minimum": 1, "maximum": 300},
        "OTHER": {"type": "integer", "minimum": 1, "maximum": 300}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "n100_seen", "new200_seen", "seen_in_both_source_slices",
        "uncertain_question_ids", "uncertainty_tag_counts", "all_members_uncertain",
        "alternative_graph_question_ids", "new200_material_cross_partition_rule_eligible",
        "qualifies_n100_unseen_material_cross_partition_recurrence"
      ],
      "properties": {
        "n100_seen": {"type": "boolean"},
        "new200_seen": {"type": "boolean"},
        "seen_in_both_source_slices": {"type": "boolean"},
        "uncertain_question_ids": {
          "type": "array", "maxItems": 300, "uniqueItems": true,
          "items": {"$ref": "#/$defs/question_id"}
        },
        "uncertainty_tag_counts": {"$ref": "#/$defs/uncertainty_tag_count_map"},
        "all_members_uncertain": {"type": "boolean"},
        "alternative_graph_question_ids": {
          "type": "array", "maxItems": 300, "uniqueItems": true,
          "items": {"$ref": "#/$defs/question_id"}
        },
        "new200_material_cross_partition_rule_eligible": {"type": "boolean"},
        "qualifies_n100_unseen_material_cross_partition_recurrence": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "representative_selection": {
      "type": "object",
      "required": ["selection_id", "quota", "method", "question_ids"],
      "properties": {
        "selection_id": {"const": "hybridqa_n300_candidate_backbone_coverage_sample_v0_1"},
        "quota": {"type": "integer", "minimum": 1, "maximum": 10},
        "method": {"const": "greedy_equal_axis_marginal_coverage_then_seeded_hash"},
        "question_ids": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": {"$ref": "#/$defs/question_id"}
        }
      },
      "additionalProperties": false
    },
    "caveats": {
      "type": "object",
      "required": [
        "same_role_contraction_establishes_semantic_equivalence",
        "producer_partitions_are_independent_reviewers",
        "complete_status_establishes_semantic_correctness",
        "post_hoc_semantic_family_merge_performed", "family_is_gold"
      ],
      "properties": {
        "same_role_contraction_establishes_semantic_equivalence": {"const": false},
        "producer_partitions_are_independent_reviewers": {"const": false},
        "complete_status_establishes_semantic_correctness": {"const": false},
        "post_hoc_semantic_family_merge_performed": {"const": false},
        "family_is_gold": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
