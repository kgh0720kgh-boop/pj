{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "representative_environment_view_schema_v0_1.json",
  "title": "Representative HybridQA environment input view v0.1",
  "description": "One hash-bound full-table and exact table-link-closure input view for the frozen 71-question candidate-backbone coverage sample. Ordinary source facts are visible, but official answer annotations, traces, groundings, executions, and prior operator proposals are absent.",
  "type": "object",
  "required": [
    "schema_version",
    "view_id",
    "run_id",
    "selection_id",
    "selection_index",
    "question_id",
    "family_id",
    "contracted_signature_sha256",
    "visibility",
    "payload",
    "payload_sha256",
    "source_bindings",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "representative_environment_view_v0_1"
    },
    "view_id": {
      "type": "string",
      "pattern": "^representative_environment_view_v0_1:[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "maxLength": 320
    },
    "run_id": {
      "$ref": "#/$defs/stable_id"
    },
    "selection_id": {
      "const": "hybridqa_n300_candidate_backbone_coverage_sample_v0_1"
    },
    "selection_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 71
    },
    "question_id": {
      "$ref": "#/$defs/stable_id"
    },
    "family_id": {
      "type": "string",
      "pattern": "^cbf_v0_1:[0-9a-f]{64}$"
    },
    "contracted_signature_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "visibility": {
      "const": "question_candidate_backbone_full_table_and_table_link_closure_no_answer_trace_grounding_execution_or_operator_proposals"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_bindings": {
      "$ref": "#/$defs/source_bindings"
    },
    "evidence_boundary": {
      "$ref": "#/$defs/evidence_boundary"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "maxLength": 256
    },
    "table_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n/\\\\]+$"
    },
    "source_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "nullable_text": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_binding": {
      "type": "object",
      "required": [
        "repository_relative_path",
        "sha256"
      ],
      "properties": {
        "repository_relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "maxLength": 1024
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "selection_artifact_binding": {
      "type": "object",
      "required": [
        "repository_relative_path",
        "sha256",
        "selected_question_count",
        "selected_question_ids_ordered_sha256",
        "selected_question_ids_set_sha256"
      ],
      "properties": {
        "repository_relative_path": {
          "const": "data_construction/exploration/ai_question_structure_scale_v0_1/candidate_backbone_library_v0_1/representative_selection_v0_1.json"
        },
        "sha256": {
          "const": "2600f22721216e0e804de88726e4fb6d8a9d99830e445cd278b1af8b383bbf2a"
        },
        "selected_question_count": {
          "const": 71
        },
        "selected_question_ids_ordered_sha256": {
          "const": "5403debe2cbe9c7f55ded0a01b49d7c42bf03e53a71350efe269bbd3c0bdcb2e"
        },
        "selected_question_ids_set_sha256": {
          "const": "9b6e05650834871ce30acc1c2dfde18fc64910dcd238982f5d482f6a31e15680"
        }
      },
      "additionalProperties": false
    },
    "official_question_source": {
      "type": "object",
      "required": [
        "source_id",
        "pinned_commit",
        "portable_path",
        "sha256",
        "projection_allowlist"
      ],
      "properties": {
        "source_id": {
          "const": "hybridqa_questions_and_code"
        },
        "pinned_commit": {
          "const": "db22fda8c5951438fade3c69d75b350335ba93b3"
        },
        "portable_path": {
          "const": "released_data/dev.json"
        },
        "sha256": {
          "const": "424272b233735a70ed8ef5af4a615373d114f472168c686c4370d54c92d58ac1"
        },
        "projection_allowlist": {
          "type": "array",
          "prefixItems": [
            {
              "const": "question_id"
            },
            {
              "const": "question"
            },
            {
              "const": "table_id"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "portable_environment_file": {
      "type": "object",
      "required": [
        "source_id",
        "pinned_commit",
        "portable_path",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "const": "hybridqa_linked_tables_and_passages"
        },
        "pinned_commit": {
          "const": "dc066e1a6d5281511d8b73a6107d5ad2824cc2b2"
        },
        "portable_path": {
          "type": "string",
          "pattern": "^(?:tables_tok|request_tok)/[^\\r\\n/\\\\]+\\.json$",
          "maxLength": 1024
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "source_bindings": {
      "type": "object",
      "required": [
        "representative_selection",
        "semantic_backbone_records",
        "candidate_families",
        "official_questions",
        "table_file",
        "request_file"
      ],
      "properties": {
        "representative_selection": {
          "$ref": "#/$defs/selection_artifact_binding"
        },
        "semantic_backbone_records": {
          "$ref": "#/$defs/artifact_binding"
        },
        "candidate_families": {
          "$ref": "#/$defs/artifact_binding"
        },
        "official_questions": {
          "$ref": "#/$defs/official_question_source"
        },
        "table_file": {
          "$ref": "#/$defs/portable_environment_file"
        },
        "request_file": {
          "$ref": "#/$defs/portable_environment_file"
        }
      },
      "additionalProperties": false
    },
    "semantic_role": {
      "enum": [
        "RESOLVE_REFERENT",
        "ACQUIRE_PROPERTY",
        "COMPARE",
        "AGGREGATE",
        "ORDER_OR_EXTREMUM",
        "DERIVE",
        "VERIFY",
        "COMBINE",
        "OTHER"
      ]
    },
    "semantic_node": {
      "type": "object",
      "required": [
        "node_id",
        "role",
        "other_role_description",
        "description",
        "source_cues",
        "implicit_rationale",
        "depends_on"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^n[1-9][0-9]*$"
        },
        "role": {
          "$ref": "#/$defs/semantic_role"
        },
        "other_role_description": {
          "$ref": "#/$defs/nullable_text"
        },
        "description": {
          "$ref": "#/$defs/nonempty_text"
        },
        "source_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_text"
          }
        },
        "implicit_rationale": {
          "$ref": "#/$defs/nullable_text"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^n[1-9][0-9]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "OTHER"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "other_role_description": {
                "$ref": "#/$defs/nonempty_text"
              }
            }
          },
          "else": {
            "properties": {
              "other_role_description": {
                "type": "null"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "semantic_graph": {
      "type": "object",
      "required": [
        "nodes",
        "entry_node_ids",
        "output_node_ids"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/semantic_node"
          }
        },
        "entry_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^n[1-9][0-9]*$"
          }
        },
        "output_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^n[1-9][0-9]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "answer_spec": {
      "type": "object",
      "required": [
        "kind",
        "cardinality",
        "description",
        "source_cues",
        "implicit_rationale"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entity",
            "attribute_value",
            "numeric_value",
            "date_time",
            "boolean",
            "textual_explanation",
            "other",
            "unknown"
          ]
        },
        "cardinality": {
          "enum": [
            "one",
            "multiple",
            "unknown"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonempty_text"
        },
        "source_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_text"
          }
        },
        "implicit_rationale": {
          "$ref": "#/$defs/nullable_text"
        }
      },
      "additionalProperties": false
    },
    "alternative_graph": {
      "type": "object",
      "required": [
        "alternative_id",
        "reason",
        "graph"
      ],
      "properties": {
        "alternative_id": {
          "type": "string",
          "pattern": "^alt[1-9][0-9]*$"
        },
        "reason": {
          "$ref": "#/$defs/nonempty_text"
        },
        "graph": {
          "$ref": "#/$defs/semantic_graph"
        }
      },
      "additionalProperties": false
    },
    "question_context": {
      "type": "object",
      "required": [
        "question",
        "question_view_sha256"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/nonempty_text"
        },
        "question_view_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "candidate_backbone_context": {
      "type": "object",
      "required": [
        "source_record_sha256",
        "question_only_answer_spec",
        "primary_graph",
        "alternative_graphs",
        "candidate_non_gold"
      ],
      "properties": {
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "question_only_answer_spec": {
          "$ref": "#/$defs/answer_spec"
        },
        "primary_graph": {
          "$ref": "#/$defs/semantic_graph"
        },
        "alternative_graphs": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/alternative_graph"
          }
        },
        "candidate_non_gold": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": [
        "column_index",
        "text",
        "linked_document_ids"
      ],
      "properties": {
        "column_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "linked_document_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_identifier"
          }
        }
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": [
        "column_index",
        "text",
        "linked_document_ids"
      ],
      "properties": {
        "column_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "linked_document_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_identifier"
          }
        }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "row_index",
        "cells"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      },
      "additionalProperties": false
    },
    "linked_document": {
      "type": "object",
      "required": [
        "document_id",
        "text"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/source_identifier"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope_contract": {
      "type": "object",
      "required": [
        "table_scope",
        "document_scope",
        "question_or_answer_guided_pruning",
        "oracle_document_selection",
        "truncation",
        "external_retrieval",
        "dataset_provided_question_table_binding",
        "table_retrieval_evaluated",
        "full_table_link_closure_supplied"
      ],
      "properties": {
        "table_scope": {
          "const": "full_selected_question_table"
        },
        "document_scope": {
          "const": "table_link_closure"
        },
        "question_or_answer_guided_pruning": {
          "const": false
        },
        "oracle_document_selection": {
          "const": false
        },
        "truncation": {
          "const": "none"
        },
        "external_retrieval": {
          "const": false
        },
        "dataset_provided_question_table_binding": {
          "const": true
        },
        "table_retrieval_evaluated": {
          "const": false
        },
        "full_table_link_closure_supplied": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "source_split",
        "table_id",
        "title",
        "section_title",
        "columns",
        "rows",
        "linked_documents",
        "scope_contract"
      ],
      "properties": {
        "source_split": {
          "const": "dev"
        },
        "table_id": {
          "$ref": "#/$defs/table_id"
        },
        "title": {
          "type": "string"
        },
        "section_title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "linked_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linked_document"
          }
        },
        "scope_contract": {
          "$ref": "#/$defs/scope_contract"
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "question_context",
        "candidate_backbone_context",
        "environment"
      ],
      "properties": {
        "question_context": {
          "$ref": "#/$defs/question_context"
        },
        "candidate_backbone_context": {
          "$ref": "#/$defs/candidate_backbone_context"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        }
      },
      "additionalProperties": false
    },
    "evidence_boundary": {
      "type": "object",
      "required": [
        "evidence_class",
        "human_evidence_count",
        "gold_claimed",
        "official_answer_annotation_in_view",
        "official_answer_or_trace_fields_in_view",
        "official_dev_blob_read_for_question_to_table_mapping",
        "answer_field_projected",
        "trace_or_reference_artifact_read",
        "official_trace_in_view",
        "historical_graph_in_view",
        "operator_proposal_in_view",
        "dataset_provided_question_table_binding",
        "table_retrieval_evaluated",
        "full_table_link_closure_supplied",
        "grounding_evaluated",
        "execution_evaluated",
        "answer_recovery_evaluated",
        "modeling_ready_claimed"
      ],
      "properties": {
        "evidence_class": {
          "const": "ai_exploratory_non_human_non_gold"
        },
        "human_evidence_count": {
          "const": 0
        },
        "gold_claimed": {
          "const": false
        },
        "official_answer_annotation_in_view": {
          "const": false
        },
        "official_answer_or_trace_fields_in_view": {
          "const": false
        },
        "official_dev_blob_read_for_question_to_table_mapping": {
          "const": true
        },
        "answer_field_projected": {
          "const": false
        },
        "trace_or_reference_artifact_read": {
          "const": false
        },
        "official_trace_in_view": {
          "const": false
        },
        "historical_graph_in_view": {
          "const": false
        },
        "operator_proposal_in_view": {
          "const": false
        },
        "dataset_provided_question_table_binding": {
          "const": true
        },
        "table_retrieval_evaluated": {
          "const": false
        },
        "full_table_link_closure_supplied": {
          "const": true
        },
        "grounding_evaluated": {
          "const": false
        },
        "execution_evaluated": {
          "const": false
        },
        "answer_recovery_evaluated": {
          "const": false
        },
        "modeling_ready_claimed": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  }
}
