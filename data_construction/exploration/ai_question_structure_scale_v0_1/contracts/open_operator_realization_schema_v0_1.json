                "const": "partially_realized"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "candidate_ids": {
                "maxItems": 0
              },
              "blocking_unsupported_node_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
