{
  "schema_ref": "../schemas/operator_vocabulary_schema_v0_1.json",
  "schema_version": "operator_vocabulary_schema_v0_1",
  "vocabulary_version": "operator_vocabulary_fine_v0_1",
  "granularity": "fine",
  "status": "provisional_candidate",
  "domain_scope": "HybridQA_only",
  "selection_claim": "not_selected_pending_annotation_evidence",
  "empirical_evidence_status": "not_yet_piloted",
  "type_system": {
    "status": "candidate_not_ir_v0_2",
    "note": "Fine analysis contracts deliberately expose micro-steps. They are not claims about the unavailable local IR v0.2 registry.",
    "types": [
      {"name": "Table", "description": "A structured HybridQA table."},
      {"name": "RowSet", "description": "Rows preserving stable row keys."},
      {"name": "CellSet", "description": "Cells paired with row and column provenance."},
      {"name": "EntitySet", "description": "Entity-denoting values preserving candidate keys."},
      {"name": "LinkSet", "description": "Linked-document locators paired with source entities."},
      {"name": "String", "description": "A text query or scalar surface value."},
      {"name": "DocumentSet", "description": "Documents with retrieval or link provenance."},
      {"name": "SentenceSet", "description": "Selected sentences with document offsets."},
      {"name": "TextSpanSet", "description": "Extracted spans with character provenance."},
      {"name": "DateSet", "description": "Parsed date values preserving keys."},
      {"name": "NumberSet", "description": "Parsed numeric values preserving units and keys."},
      {"name": "Value", "description": "One typed scalar value."},
      {"name": "ValueSet", "description": "Typed scalar values."},
      {"name": "KeyedValueSet", "description": "Values paired with candidate keys."},
      {"name": "ComparisonSet", "description": "Pairwise comparison outcomes or ordering metadata."},
      {"name": "KeySet", "description": "Selected candidate keys."}
    ]
  },
  "operators": [
    {
      "name": "SELECT_ROWS",
      "category": "structured_access",
      "purpose": "Apply one grounded predicate to table rows.",
      "semantics": "Return rows satisfying exactly one declared predicate, preserving row keys.",
      "semantic_functions_supported": ["SELECT_CANDIDATES", "RESTRICT_CANDIDATES"],
      "input_ports": [{"name": "rows", "type": "Table|RowSet", "cardinality": "one", "description": "Table or row subset."}],
      "output_ports": [{"name": "rows", "type": "RowSet", "cardinality": "zero_or_more", "description": "Selected rows."}],
      "argument_slots": [{"name": "predicate", "binding_kind": "row_predicate", "required": true, "description": "Single row predicate."}],
      "tool_binding_class": ["table_engine"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Single-predicate row selection is generic."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "Row identity and collection type are preserved."},
        "executability": {"provisional_rating": "high", "rationale": "Direct table predicate execution is deterministic."},
        "composability": {"provisional_rating": "high", "rationale": "RowSet can feed another predicate or cell read."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "Compound filters must be decomposed."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "Decomposition agreement is unmeasured."}
      },
      "known_risks": ["Multiple predicates lengthen the graph"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "READ_CELL",
      "category": "structured_access",
      "purpose": "Read one grounded column from keyed rows.",
      "semantics": "Return provenance-bearing cells without interpreting links or parsing content.",
      "semantic_functions_supported": ["RESOLVE_RELATION", "ACQUIRE_ATTRIBUTE", "RETURN_ANSWER"],
      "input_ports": [{"name": "rows", "type": "RowSet", "cardinality": "one", "description": "Rows to read."}],
      "output_ports": [{"name": "cells", "type": "CellSet", "cardinality": "zero_or_more", "description": "Cells with row keys."}],
      "argument_slots": [{"name": "column", "binding_kind": "column", "required": true, "description": "One concrete column."}],
      "tool_binding_class": ["table_engine"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Cell reading is schema-general."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "Cells remain distinct from parsed values and links."},
        "executability": {"provisional_rating": "high", "rationale": "Column access is deterministic."},
        "composability": {"provisional_rating": "high", "rationale": "Cells feed link traversal, parsing, or answer return."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "Only one column read occurs."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "No fine-grained pilot exists."}
      },
      "known_risks": ["One node per field may inflate simple table plans"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "FOLLOW_LINK",
      "category": "document_access",
      "purpose": "Resolve linked-document locators from cells or entities.",
      "semantics": "Traverse an explicit environment link while preserving source candidate identity; do not fetch document content.",
      "semantic_functions_supported": ["RESOLVE_RELATION"],
      "input_ports": [{"name": "sources", "type": "CellSet|EntitySet", "cardinality": "one_or_more", "description": "Link-bearing cells or entities."}],
      "output_ports": [{"name": "links", "type": "LinkSet", "cardinality": "zero_or_more", "description": "Resolved locators."}],
      "argument_slots": [{"name": "locator", "binding_kind": "document_locator", "required": true, "description": "Link resolution rule."}],
      "tool_binding_class": ["graph_runtime", "table_engine"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Link traversal is attribute-independent."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "Locator resolution is separate from retrieval."},
        "executability": {"provisional_rating": "medium", "rationale": "Requires linked-document metadata."},
        "composability": {"provisional_rating": "high", "rationale": "LinkSet feeds retrieval."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "One explicit relation traversal occurs."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "Link versus search decisions need review."}
      },
      "known_risks": ["May be omitted when a runtime follows links implicitly"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "RETRIEVE",
      "category": "document_access",
      "purpose": "Fetch or search for document content from locators or query text.",
      "semantics": "Return provenance-bearing documents; do not select sentences or extract spans.",
      "semantic_functions_supported": ["RESOLVE_RELATION", "ACQUIRE_ATTRIBUTE"],
      "input_ports": [{"name": "request", "type": "LinkSet|EntitySet|String", "cardinality": "one_or_more", "description": "Links, entities, or query text."}],
      "output_ports": [{"name": "documents", "type": "DocumentSet", "cardinality": "zero_or_more", "description": "Retrieved documents."}],
      "argument_slots": [{"name": "locator", "binding_kind": "document_locator", "required": false, "description": "Direct or linked locator."}, {"name": "query", "binding_kind": "retrieval_query", "required": false, "description": "Search query template."}],
      "tool_binding_class": ["retriever"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Content retrieval is generic."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "DocumentSet has explicit provenance."},
        "executability": {"provisional_rating": "medium", "rationale": "Retriever availability and recall are external."},
        "composability": {"provisional_rating": "high", "rationale": "Documents feed sentence selection."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "Retrieval is separated from reading."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "No natural annotations have been compared."}
      },
      "known_risks": ["Search and direct fetch share a name despite different failure modes"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "SELECT_SENTENCE",
      "category": "extraction",
      "purpose": "Select evidence sentences relevant to one requested attribute.",
      "semantics": "Rank or filter sentences within documents while preserving offsets and subject keys; do not extract the answer span.",
      "semantic_functions_supported": ["ACQUIRE_ATTRIBUTE"],
      "input_ports": [{"name": "documents", "type": "DocumentSet", "cardinality": "one_or_more", "description": "Retrieved documents."}],
      "output_ports": [{"name": "sentences", "type": "SentenceSet", "cardinality": "zero_or_more", "description": "Selected evidence sentences."}],
      "argument_slots": [{"name": "attribute", "binding_kind": "requested_attribute", "required": true, "description": "Attribute sought."}, {"name": "selection", "binding_kind": "selection_policy", "required": true, "description": "Sentence selection policy."}],
      "tool_binding_class": ["reader"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Evidence sentence selection transfers across attributes."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "Sentence offsets are distinct from answer spans."},
        "executability": {"provisional_rating": "medium", "rationale": "May require a learned reader component."},
        "composability": {"provisional_rating": "high", "rationale": "SentenceSet feeds span extraction."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "Evidence localization is isolated."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "Sentence boundary agreement is unknown."}
      },
      "known_risks": ["Sentence supervision substantially raises annotation cost"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "EXTRACT_SPAN",
      "category": "extraction",
      "purpose": "Extract exact attribute spans from selected sentences.",
      "semantics": "Return character-aligned raw spans with document provenance and candidate keys; do not parse them.",
      "semantic_functions_supported": ["ACQUIRE_ATTRIBUTE"],
      "input_ports": [{"name": "sentences", "type": "SentenceSet", "cardinality": "one_or_more", "description": "Evidence sentences."}],
      "output_ports": [{"name": "spans", "type": "TextSpanSet", "cardinality": "zero_or_more", "description": "Raw answer spans."}],
      "argument_slots": [{"name": "attribute", "binding_kind": "requested_attribute", "required": true, "description": "Attribute to extract."}, {"name": "cardinality", "binding_kind": "cardinality", "required": true, "description": "Expected spans per subject."}],
      "tool_binding_class": ["reader"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Span extraction is attribute-parameterized."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "Raw spans are explicit and provenance-bearing."},
        "executability": {"provisional_rating": "medium", "rationale": "Reader capability may fail despite valid semantics."},
        "composability": {"provisional_rating": "high", "rationale": "Spans feed type-specific parsers."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "No retrieval or parsing is hidden."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "Exact span agreement is unmeasured."}
      },
      "known_risks": ["Exact-span annotation can over-penalize equivalent evidence"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "PARSE_DATE",
      "category": "transformation",
      "purpose": "Parse raw date expressions into typed date values.",
      "semantics": "Interpret date spans using an explicit format or locale rule and preserve raw text and candidate keys.",
      "semantic_functions_supported": ["PARSE_SEMANTIC_VALUE"],
      "input_ports": [{"name": "spans", "type": "TextSpanSet|CellSet", "cardinality": "one_or_more", "description": "Raw date expressions."}],
