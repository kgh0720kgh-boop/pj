      "argument_slots": [{"name": "value_type", "binding_kind": "declared_value_type", "required": true, "description": "Date or datetime target."}, {"name": "format", "binding_kind": "normalization_rule", "required": false, "description": "Format and locale."}],
      "tool_binding_class": ["parser", "deterministic_function"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Date parsing is domain-general."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "DateSet excludes other numeric types."},
        "executability": {"provisional_rating": "high", "rationale": "Known formats are deterministically parseable."},
        "composability": {"provisional_rating": "high", "rationale": "Dates feed normalization and comparison."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "Parsing is separate from normalization."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "Implicit versus explicit parsing nodes need study."}
      },
      "known_risks": ["Partial dates and calendars require explicit policies"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "PARSE_NUMBER",
      "category": "transformation",
      "purpose": "Parse raw numeric expressions and units.",
      "semantics": "Interpret numeric spans without performing unit conversion or arithmetic.",
      "semantic_functions_supported": ["PARSE_SEMANTIC_VALUE"],
      "input_ports": [{"name": "spans", "type": "TextSpanSet|CellSet", "cardinality": "one_or_more", "description": "Raw numeric expressions."}],
      "output_ports": [{"name": "numbers", "type": "NumberSet", "cardinality": "zero_or_more", "description": "Parsed numbers with units."}],
      "argument_slots": [{"name": "value_type", "binding_kind": "declared_value_type", "required": true, "description": "Integer or number target."}, {"name": "format", "binding_kind": "normalization_rule", "required": false, "description": "Locale and numeric format."}],
      "tool_binding_class": ["parser", "deterministic_function"],
      "design_assessment": {
        "reusability": {"provisional_rating": "high", "rationale": "Numeric parsing is domain-general."},
        "typed_contract_clarity": {"provisional_rating": "high", "rationale": "Numbers and units are explicit."},
        "executability": {"provisional_rating": "high", "rationale": "Known numeric formats are deterministic."},
        "composability": {"provisional_rating": "high", "rationale": "Numbers feed normalization, arithmetic, and comparison."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "Unit conversion is not hidden."},
        "annotation_stability": {"status": "unknown_pending_pilot", "rationale": "No fine-grained pilot exists."}
      },
      "known_risks": ["Ranges and approximate quantities require policies"],
      "empirical_frequency_status": "not_measured"
    },
    {
      "name": "NORMALIZE",
      "category": "transformation",
      "purpose": "Normalize typed values to a declared comparison or arithmetic representation.",
      "semantics": "Apply one explicit unit, timezone, calendar, or identity normalization while retaining original values.",
      "semantic_functions_supported": ["NORMALIZE_SEMANTIC_VALUE"],
      "input_ports": [{"name": "values", "type": "DateSet|NumberSet|ValueSet", "cardinality": "one_or_more", "description": "Typed values."}],
      "output_ports": [{"name": "values", "type": "DateSet|NumberSet|ValueSet", "cardinality": "one_or_more", "description": "Normalized values."}],
