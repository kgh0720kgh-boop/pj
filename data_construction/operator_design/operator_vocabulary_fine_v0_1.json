        "executability": {"provisional_rating": "high", "rationale": "Grounded transformations are deterministic."},
        "composability": {"provisional_rating": "high", "rationale": "Output substitutes directly in reasoning nodes."},
        "semantic_atomicity": {"provisional_rating": "high", "rationale": "One normalization rule is applied."},
